{
  "name": "esm-treeshake-lab",
  "version": "0.3.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/lab/*",
    "packages/lab/smoke/*",
    "packages/lab/smoke/*/*"
  ],
  "scripts": {
    "dev": "nx run @apps/docs:dev",
    "build": "nx run @apps/docs:build",
    "start": "nx run @apps/docs:start",
    "preview": "nx run @apps/docs:preview",
    "deploy": "nx run @apps/docs:deploy",
    "lab:generate": "bun run scripts/lab/generate-scale-bench.ts",
    "lab:bench": "bun run scripts/lab/run-scale-bench.ts",
    "lab:bench:smoke": "bun run scripts/lab/run-scale-bench.ts --smoke",
    "lab:bench:wide": "bun run scripts/lab/run-scale-bench.ts --case=wide",
    "lab:bench:cycles": "bun run scripts/lab/run-scale-bench.ts --case=cycles",
    "lab:bench:partial": "bun run scripts/lab/run-scale-bench.ts --case=partial",
    "orchestrate": "bun run .sandcastle/orchestrate.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@nx/next": "21.6.11",
    "@nx/web": "21.6.11",
    "esbuild": "^0.25.0",
    "nx": "21.6.11",
    "typescript": "~5.8.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
