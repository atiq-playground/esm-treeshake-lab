# Copy to .sandcastle/.env and fill in real values before running
# `bun run orchestrate <issue-number>` locally. Never commit the real .env —
# see .sandcastle/.gitignore. In the AFK Action (create-atiq-app issue #11)
# these are minted per-run instead of read from this file.

# Claude Code auth — set exactly ONE of the two below.
# Run `claude setup-token` on your host to mint an OAuth token.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an API key instead of the OAuth token:
# ANTHROPIC_API_KEY=

# Used by the prompt's `gh issue view`/`gh pr` dynamic context and by orchestrate.ts
# to push the agent's branch. In CI this is a GitHub App token, not a static PAT
# (see create-atiq-app issue #11) — only needed here for local manual runs.
GH_TOKEN=

# Sandbox provider seam (see orchestrate.ts SANDBOX_PROVIDERS). Defaults to "docker"
# when unset — only needed to override.
# SANDCASTLE_SANDBOX=docker
# SANDCASTLE_IMAGE_NAME=sandcastle:next-app
